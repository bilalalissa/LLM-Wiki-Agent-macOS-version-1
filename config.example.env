# LLM Wiki Agent configuration template.
# The native macOS app copies this file to:
# ~/Library/Application Support/LLM Wiki Agent/config.env

AI_ACCESS_METHOD=subscription_cli
DEFAULT_AI_PROVIDER=openai_subscription
DEFAULT_AI_MODEL=gpt-5.4

OPENAI_AUTH_METHOD=subscription
OPENAI_SUBSCRIPTION_CLIENT=codex
OPENAI_CODEX_COMMAND=codex
OPENAI_CODEX_LOGIN_CHECK_COMMAND="codex login status"
OPENAI_CODEX_TIMEOUT_MS=180000

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

ANTHROPIC_AUTH_METHOD=api_key
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_COMPAT_AUTH_METHOD=api_key
OPENAI_COMPAT_API_KEY=replace-with-your-openai-compatible-api-key
OPENAI_COMPAT_BEARER_TOKEN=replace-with-your-openai-compatible-bearer-token
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1

GEMINI_AUTH_METHOD=api_key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_OAUTH_ACCESS_TOKEN=replace-with-your-gemini-oauth-access-token
GEMINI_OAUTH_TOKEN_FILE=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Set this to the folder that contains one or more Obsidian vault folders.
# Each LLM Wiki vault must be named *-vault and contain AGENTS.md.
VAULTS_ROOT=~/Documents/Obsidian-Vaults

WATCH_INTERVAL_MS=5000
INGEST_MAX_CHARS=60000
CHAT_MAX_FILES=24
CHAT_PORT=8789

# Mac Bridge for iPad/iPhone clients. Use 127.0.0.1 for Mac-only access,
# or 0.0.0.0 to allow devices on your local network to connect.
MAC_BRIDGE_HOST=127.0.0.1
MAC_BRIDGE_TOKEN=
